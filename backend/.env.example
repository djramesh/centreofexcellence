# ─────────────────────────────────────────────────────────────────────────────
# Copy to backend/.env and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# Add your production domain here before going live.
ALLOWED_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
# Set the discrete DB_* vars for local development. They take precedence.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coe_ecommerce

# On a managed host (Railway, PlanetScale) leave DB_HOST unset and this URL is
# used instead. Railway injects MYSQL_URL automatically.
# MYSQL_URL=mysql://user:password@host:3306/database

DB_POOL_LIMIT=20
DB_QUEUE_LIMIT=0

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production; must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Use TEST keys until you are ready to take real payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Strongly recommended. Without it the webhook is ignored, so an order is only
# ever confirmed by the browser — a customer who closes the tab right after
# paying leaves a paid order stuck as PENDING.
# Set the same value in Razorpay Dashboard → Settings → Webhooks, pointing at
#   https://<your-api-domain>/api/checkout/webhook
# and subscribe to `payment.captured` and `order.paid`.
RAZORPAY_WEBHOOK_SECRET=

# ── Image storage (optional) ─────────────────────────────────────────────────
# If unset, product images are written to backend/public/assets instead.
# On an ephemeral host those are lost on every redeploy, so set these in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ShipRocket (optional) ────────────────────────────────────────────────────
# Only needed to book shipments through ShipRocket. Tracking numbers for any
# other courier can always be entered manually in the admin panel.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
# Pincode you dispatch from, used for courier serviceability lookups.
SHIPROCKET_PICKUP_PINCODE=781001

# ── Tuning ───────────────────────────────────────────────────────────────────
# Proxy hops to trust for the real client IP. 1 is correct behind Railway,
# Netlify or a single nginx. Raise only if you have more proxies in front.
TRUST_PROXY_HOPS=1

RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CHECKOUT_MAX=20

# Days an unpaid order stays PENDING before it is auto-cancelled.
PENDING_ORDER_TTL_DAYS=2
