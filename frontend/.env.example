# Frontend environment variables
# Copy this to .env and fill in your actual values.

# API base URL — where the backend is reachable from the browser.
#   Development: http://localhost:4000
#   Production:  https://your-api-domain.com (set VITE_API_URL in the Netlify UI)
VITE_API_URL=http://localhost:4000

# NOTE: there is deliberately no VITE_RAZORPAY_KEY_ID here.
# The Razorpay key id is returned by the backend when an order is created, so
# the SPA never needs its own copy and the two can never drift out of sync.

# Optional: analytics / error tracking
# VITE_GA_ID=your_google_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn_url
